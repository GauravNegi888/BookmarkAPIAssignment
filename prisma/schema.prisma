generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Folder {
  id        String     @id @default(uuid())
  name      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bookmarks Bookmark[]

  @@index([name])
}

model Bookmark {
  id        String   @id @default(uuid())
  title     String
  url       String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  folderId String
  folder   Folder   @relation(fields: [folderId], references: [id], onDelete: Cascade)

  @@index([folderId])
  @@index([title])
}